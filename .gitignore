# =============================================================================
# .gitignore — Node / npm / Python / Java / .NET / Flutter
#
# Locked by a GitHub push ruleset. Malware has rewritten this file before
# (appending `!.env*` so secrets got committed). To change it: switch the
# ruleset off, edit, push, switch it back on.
#
# Deliberately NOT used, because they hide real source folders:
#   lib/  lib64/  packages/  [Dd]ebug/  [Rr]elease/  parts/  var/  include/
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets & credentials — never commit
# -----------------------------------------------------------------------------
.env*
*.env
.envrc
.secrets
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.gpg
id_rsa*
id_ed25519*
key.properties
credentials.json
service-account*.json
*-credentials.json
.aws/
.netrc
.npmrc
.yarnrc
.pypirc
*.pubxml
*.publishsettings
local.properties

# Safe templates (must stay below the rules above)
!.env.example
!*.env.example


# -----------------------------------------------------------------------------
# Editors & IDEs — .vscode/tasks.json was a malware vector
# -----------------------------------------------------------------------------
.vscode/
.idea/
.vs/
.cursor/
.fleet/
.history/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.loadpath
.metadata/
nbproject/private/
*.swp
*.swo
*~
\#*\#
.\#*


# -----------------------------------------------------------------------------
# Operating systems
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk
.directory
.Trash-*


