{
  "name": "bbda-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BBDA NestJS modular monolith: api, realtime and worker runtimes",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/entrypoints/api.js",
    "start:realtime": "node dist/entrypoints/realtime.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "test": "jest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.7",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fastify": "5.12.5"
  }
}
